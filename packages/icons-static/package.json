{
  "name": "@bestiary-ui/icons-static",
  "version": "0.1.0",
  "description": "Static optimized SVG files, SVG sprite, and ESM SVG strings for @bestiary-ui/icons",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./sprite.svg": "./sprite.svg",
    "./icons/*": "./icons/*"
  },
  "files": [
    "dist",
    "icons",
    "sprite.svg"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  }
}
