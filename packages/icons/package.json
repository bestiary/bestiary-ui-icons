{
  "name": "@bestiary-ui/icons",
  "version": "0.1.0",
  "description": "Framework-agnostic icon library with native outline and solid variants",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "unpkg": "./dist/umd/bestiary-icons.min.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./icons/*": {
      "types": "./dist/types/generated/icons/*.d.ts",
      "import": "./dist/esm/generated/icons/*.js",
      "require": "./dist/cjs/generated/icons/*.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.umd.config.ts",
    "typecheck": "tsc --noEmit"
  }
}
