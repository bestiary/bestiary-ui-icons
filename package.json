{
  "name": "bestiary-ui-icons-monorepo",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "validate:icons": "tsx tools/src/cli-validate.ts",
    "generate:icons": "tsx tools/src/cli-generate.ts",
    "build": "pnpm generate:icons && turbo run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck",
    "dev:preview": "pnpm --filter @bestiary-ui/icons-preview dev",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.4",
    "@types/node": "^22.15.2",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/test-utils": "^2.4.6",
    "ajv": "^8.17.1",
    "esbuild": "^0.25.2",
    "jsdom": "^26.1.0",
    "rollup": "^4.40.0",
    "svgo": "^3.3.2",
    "svgson": "^5.3.1",
    "tsx": "^4.19.3",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.2",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^3.1.1",
    "vue": "^3.5.13"
  }
}
